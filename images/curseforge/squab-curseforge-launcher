class Fail(Exception):
    """A user-facing failure. Messages never contain the API key."""

    def __init__(self, message, code=65):
        super().__init__(message)
        self.code = code


class Transient(Fail):
    """CurseForge or the network is temporarily unavailable."""


def log(message):
    print('[Squab] ' + message, file=sys.stderr, flush=True)


# --- configuration ---------------------------------------------------------------

def validate_environment(environ):
    if environ.get('SQUAB_SYSTEM_LICENSE_ACCEPTED') != 'true':
        raise Fail('Trusted Minecraft EULA acceptance is required', 64)
    if any(name.startswith('SQUAB_SYSTEM_') and name != 'SQUAB_SYSTEM_LICENSE_ACCEPTED' for name in environ):
        raise Fail('Unsupported protected environment key', 64)
    if any(environ.get(name) for name in ('JAVA_TOOL_OPTIONS', 'JDK_JAVA_OPTIONS', '_JAVA_OPTIONS')):
        raise Fail('Customer Java options are not supported', 64)
    if 'CF_API_KEY' in environ:
        raise Fail('CF_API_KEY must be delivered as a Squab secret file, not as an environment variable', 64)


def read_api_key(environ):
    path, expected = environ.get('CF_API_KEY_FILE'), SECRET_PATH
    if not path:
        raise Fail('CF_API_KEY is not set. Add your CurseForge API key in the server configuration.', 64)
    if path != expected:
        raise Fail('CF_API_KEY_FILE must name the Squab secret file', 64)
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(descriptor, 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise OSError
            raw = stream.read(4097)
    except OSError:
        raise Fail('The CurseForge API key file is missing or unreadable', 64) from None
    key = raw.strip(b' \t\r\n')
    # Header-safe printable ASCII only; never echo what was rejected.
    if not 1 <= len(key) <= 4096 or not re.fullmatch(rb'[\x21-\x7e]+', key):
        raise Fail('The CurseForge API key has an invalid format', 64)
    return key.decode('ascii')


def parse_modpack(value):
    """Return ('id', int) or ('slug', str) from an ID, slug or curseforge.com project URL."""
    value = (value or '').strip()
    match = re.fullmatch(r'https://(?:www\.)?curseforge\.com/minecraft/modpacks/([a-z0-9][a-z0-9_-]{0,127})/?'
                         r'(?:files(?:/\d+)?/?)?', value)
    if match:
        return 'slug', match.group(1)
    if re.fullmatch(r'[1-9][0-9]{0,9}', value) and int(value) < 2**31:
        return 'id', int(value)
    if re.fullmatch(r'[a-z0-9][a-z0-9_-]{0,127}', value) and not value.isdigit():
        return 'slug', value
    raise Fail('CF_MODPACK must be a CurseForge modpack project ID, slug or curseforge.com project URL', 64)


def optional_int(environ, name, low, high):
    value = environ.get(name, '')
    if value == '':
        return None
    if not value.isascii() or not value.isdecimal() or not low <= int(value) <= high:
        raise Fail(f'{name} must be a whole number from {low} to {high}', 64)
    return int(value)


def choice(environ, name, options):
    value = environ.get(name, '')
    if value and value not in options:
        raise Fail(f'{name} must be one of: ' + ', '.join(options), 64)
    return value or None


def settings(environ):
    motd = environ.get('MOTD')
    if motd is not None and (len(motd) > 120 or any(ord(c) < 32 or ord(c) == 127 for c in motd)):
        raise Fail('MOTD must be at most 120 printable characters', 64)
    whitelist = environ.get('WHITELIST_ENABLED', '')
    if whitelist not in ('', 'true', 'false'):
        raise Fail('WHITELIST_ENABLED must be true or false', 64)
    java = environ.get('JAVA_VERSION', 'auto') or 'auto'
    if java not in ('auto', '8', '17', '21', '25'):
        raise Fail('JAVA_VERSION must be auto, 8, 17, 21 or 25', 64)
    return {
        'modpack': parse_modpack(environ.get('CF_MODPACK', '')),
        'file_id': optional_int(environ, 'CF_FILE_ID', 1, 2**31 - 1),
        'java': java,
        'properties': {key: value for key, value in {
            'max-players': optional_int(environ, 'MAX_PLAYERS', 1, 500),
            'difficulty': choice(environ, 'DIFFICULTY', ('peaceful', 'easy', 'normal', 'hard')),
            'gamemode': choice(environ, 'GAME_MODE', ('survival', 'creative', 'adventure', 'spectator')),
            'white-list': whitelist or None,
            'enforce-whitelist': whitelist or None,
            'motd': motd,
        }.items() if value is not None},
    }


# --- HTTP ------------------------------------------------------------------------

def connect(host):
    """The single network entry point. Tests replace it with a local transport."""
    return http.client.HTTPSConnection(host, 443, timeout=60, context=ssl.create_default_context())


def request(url, headers=None, limit=MAX_JSON, sink=None, attempts=4):
    """GET an HTTPS URL without following redirects. Returns (status, headers, body)."""
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != 'https' or not parsed.hostname or parsed.port not in (None, 443) or parsed.username:
        raise Fail('Refusing a non-HTTPS download location')
    headers = dict(headers or {})
    if 'x-api-key' in headers and parsed.hostname != API_HOST:
        raise AssertionError('the API key is only sent to ' + API_HOST)
    path = parsed.path + ('?' + parsed.query if parsed.query else '')
    for attempt in range(attempts):
        connection = connect(parsed.hostname)
        try:
            connection.request('GET', path, headers={'User-Agent': USER_AGENT, 'Accept': '*/*', **headers})
            response = connection.getresponse()
            if response.status == 429 or response.status >= 500:
                retry = response.getheader('Retry-After', '')
                response.read(65536)
                if attempt + 1 < attempts:
                    delay = int(retry) if retry.isdecimal() else 2 ** (attempt + 1)
                    if delay > 120:
                        raise Transient('CurseForge asked to wait longer than allowed; restart later')
                    log(f'{parsed.hostname} returned HTTP {response.status}; retrying in {delay}s')
                    time.sleep(delay)
                    continue
                if response.status == 429:
                    raise Transient('CurseForge rate limit reached (HTTP 429). Wait a few minutes, then start the server again.')
                raise Transient(f'{parsed.hostname} is unavailable (HTTP {response.status}). Start the server again later.')
            if sink is None or response.status != 200:
                body = response.read(limit + 1)
                if len(body) > limit:
                    raise Fail(f'Response from {parsed.hostname} is too large')
                return response.status, response, body
            total = 0
            while chunk := response.read(1024 * 1024):
                total += len(chunk)
                if total > limit:
                    raise Fail(f'Download from {parsed.hostname} exceeded its expected size')
                sink.write(chunk)
            return response.status, response, b''
        except (OSError, http.client.HTTPException):
            if attempt + 1 == attempts:
                raise Transient(f'Could not reach {parsed.hostname}. Check the node\'s internet access.') from None
            time.sleep(2 ** (attempt + 1))
        finally:
            connection.close()
    raise Transient(f'Could not reach {parsed.hostname}')


class CurseForge:
    def __init__(self, key):
        self._key = key

    def __repr__(self):
        return 'CurseForge(<api key hidden>)'

    def get(self, path, what):
        status, _, body = request(f'https://{API_HOST}{path}', {'x-api-key': self._key, 'Accept': 'application/json'})
        if status in (401, 403):
            raise Fail('CurseForge rejected the API key (HTTP %d). Check CF_API_KEY in the server configuration; '
                       'keys are created at https://console.curseforge.com.' % status, 64)
        if status == 404:
            raise Fail(f'{what} was not found on CurseForge (HTTP 404)', 64)
        if status != 200:
            raise Fail(f'Unexpected CurseForge response for {what} (HTTP {status})')
        try:
            value = json.loads(body)['data']
        except (ValueError, KeyError, TypeError):
            raise Fail(f'Invalid CurseForge response for {what}') from None
        return value

    def project(self, kind, value):
        if kind == 'id':
            mod = self.get(f'/v1/mods/{value}', f'Modpack project {value}')
        else:
            query = urllib.parse.urlencode({'gameId': MINECRAFT, 'classId': MODPACKS, 'slug': value})
            found = self.get('/v1/mods/search?' + query, f'Modpack "{value}"')
            matches = [mod for mod in found if isinstance(mod, dict) and mod.get('slug') == value] \
                if isinstance(found, list) else []
            if len(matches) != 1:
                raise Fail(f'Modpack "{value}" was not found on CurseForge', 64)
            mod = matches[0]
        if not isinstance(mod, dict) or type(mod.get('id')) is not int:
            raise Fail('Invalid CurseForge project data')
        if mod.get('gameId') != MINECRAFT or mod.get('classId') != MODPACKS:
            raise Fail(f'CurseForge project {mod["id"]} is not a Minecraft modpack', 64)
        if mod.get('allowModDistribution') is False:
            raise Fail(f'The author of "{mod.get("name", mod["id"])}" does not allow third-party downloads '
                       '(allowModDistribution=false), so Squab cannot fetch its server pack.', 64)
        return mod

    def file(self, mod_id, file_id):
        data = self.get(f'/v1/mods/{mod_id}/files/{file_id}', f'File {file_id}')
        if not isinstance(data, dict) or data.get('id') != file_id:
            raise Fail('Invalid CurseForge file data')
        if data.get('modId') != mod_id:
            raise Fail(f'File {file_id} does not belong to modpack {mod_id}', 64)
        return data

    def files(self, mod_id):
        result, index = [], 0
        for _ in range(MAX_FILE_PAGES):
            page = self.get(f'/v1/mods/{mod_id}/files?index={index}&pageSize=50', 'Modpack files')
            if not isinstance(page, list):
                raise Fail('Invalid CurseForge file list')
            result.extend(item for item in page if isinstance(item, dict))
            if len(page) < 50:
                return result
            index += 50
        return result

    def download_url(self, mod_id, file):
        url = file.get('downloadUrl')
        if not url:
            status, _, body = request(f'https://{API_HOST}/v1/mods/{mod_id}/files/{file["id"]}/download-url',
                                      {'x-api-key': self._key, 'Accept': 'application/json'})
            if status in (401, 403, 404) or status == 200 and not _json_data(body):
                raise Fail('CurseForge does not allow third-party downloads of this server pack '
                           '(the author disabled distribution). Download it manually is not supported; '
                           'choose another modpack or version.', 64)
            if status != 200:
                raise Fail(f'Unexpected CurseForge response for the download location (HTTP {status})')
            url = _json_data(body)
        if not isinstance(url, str):
            raise Fail('Invalid CurseForge download location')
        host = urllib.parse.urlsplit(url).hostname
        if not url.startswith('https://') or host not in DOWNLOAD_HOSTS:
            raise Fail('CurseForge returned a download location outside its CDN')
        return url


def _json_data(body):
    try:
        value = json.loads(body).get('data')
    except (ValueError, AttributeError):
        return None
    return value if isinstance(value, str) and value else None


def released(file):
    return file.get('isAvailable', True) is not False and file.get('fileStatus') in (4, 10, None)


def select_files(api, mod, requested):
    """Return (pack_file, server_pack_file) for the requested or latest version."""
    mod_id = mod['id']
    if requested is not None:
        chosen = api.file(mod_id, requested)
        if chosen.get('isServerPack') is True:
            parent = chosen.get('parentProjectFileId')
            return (api.file(mod_id, parent) if type(parent) is int else chosen), chosen
    else:
        candidates = [f for f in api.files(mod_id) if not f.get('isServerPack') and released(f)
                      and type(f.get('id')) is int and isinstance(f.get('fileDate'), str)]
        with_pack = [f for f in candidates if type(f.get('serverPackFileId')) is int]
        if not candidates:
            raise Fail('This modpack has no downloadable versions', 64)
        if not with_pack:
            raise Fail('No version of this modpack has a server pack. CurseForge only provides server files '
                       'when the modpack author uploads them; Squab does not convert client packs.', 64)
        for release_type in (1, 2, 3):
            typed = [f for f in with_pack if f.get('releaseType') == release_type]
            if typed:
                chosen = max(typed, key=lambda f: (f['fileDate'], f['id']))
                break
        else:
            chosen = max(with_pack, key=lambda f: (f['fileDate'], f['id']))
        newest = max(candidates, key=lambda f: (f['fileDate'], f['id']))
        if newest['id'] != chosen['id'] and newest.get('releaseType', 1) <= chosen.get('releaseType', 1):
            log(f'Newest version "{newest.get("displayName", newest["id"])}" has no server pack; '
                f'using "{chosen.get("displayName", chosen["id"])}"')
    server_id = chosen.get('serverPackFileId')
    if type(server_id) is not int:
        raise Fail(f'Version "{chosen.get("displayName", chosen["id"])}" has no server pack. CurseForge only '
                   'provides server files when the modpack author uploads them; choose a version with a server '
                   'pack in CF_FILE_ID (Squab does not convert client packs).', 64)
    server = api.file(mod_id, server_id)
    if server.get('isServerPack') is False:
        raise Fail('CurseForge server pack metadata is inconsistent')
    return chosen, server


# --- verified downloads --------------------------------------------------------

def expected_hashes(file):
    hashes = {}
    for item in file.get('hashes') or []:
        if isinstance(item, dict) and isinstance(item.get('value'), str):
            name = {1: 'sha1', 2: 'md5'}.get(item.get('algo'))
            if name and re.fullmatch('[0-9a-f]{40}' if name == 'sha1' else '[0-9a-f]{32}', item['value'].lower()):
                hashes[name] = item['value'].lower()
    if 'sha1' not in hashes:
        raise Fail('CurseForge provided no SHA-1 for this file, so it cannot be verified')
    size = file.get('fileLength')
    if type(size) is not int or not 0 < size <= MAX_ARCHIVE:
        raise Fail('The server pack size is missing or larger than Squab allows (2 GiB)')
    return size, hashes


def file_matches(path, size, hashes):
    if path.is_symlink() or not path.is_file() or path.stat().st_size != size:
        return False
    digests = {name: hashlib.new(name) for name in hashes}
    with path.open('rb') as stream:
        while chunk := stream.read(1024 * 1024):
            for digest in digests.values():
                digest.update(chunk)
    return all(digests[name].hexdigest() == value for name, value in hashes.items())


def download(url, target, size, hashes, what):
    """Stream url into target only if it matches the expected size and hashes."""
    if file_matches(target, size, hashes):
        log(f'{what}: verified cached copy')
        return target
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name('.partial-' + target.name)
    temporary.unlink(missing_ok=True)
    for _ in range(3):
        log(f'{what}: downloading {size / 1024**2:.1f} MiB from {urllib.parse.urlsplit(url).hostname}')
        with temporary.open('xb') as stream:
            status, response, _ = request(url, limit=size, sink=stream)
            stream.flush()
            os.fsync(stream.fileno())
        if status in (301, 302, 303, 307, 308):
            location = urllib.parse.urljoin(url, response.getheader('Location', ''))
            temporary.unlink()
            if urllib.parse.urlsplit(location).hostname not in TRUSTED_HOSTS or not location.startswith('https://'):
                raise Fail(f'{what}: refusing a redirect to an untrusted host')
            url = location
            continue
        if status != 200:
            temporary.unlink()
            raise Fail(f'{what}: download failed (HTTP {status})')
        if not file_matches(temporary, size, hashes):
            temporary.unlink()
            raise Fail(f'{what}: size or checksum verification failed')
        temporary.replace(target)
        return target
    raise Fail(f'{what}: too many redirects')


def sidecar_download(url, target, what, max_size=64 * 1024**2):
    """Download an official maven artifact verified by its published SHA-256 (or SHA-1)."""
    for algorithm, length in (('sha256', 64), ('sha1', 40)):
        status, _, body = request(url + '.' + algorithm, limit=1024)
        if status == 200:
            value = body.decode('ascii', 'replace').strip().split()[0].lower() if body.strip() else ''
            if re.fullmatch(f'[0-9a-f]{{{length}}}', value):
                break
    else:
        raise Fail(f'{what}: the official maven publishes no checksum')
    with_size = target.with_name('.probe-' + target.name)
    with_size.unlink(missing_ok=True)
    with with_size.open('xb') as stream:
        status, _, _ = request(url, limit=max_size, sink=stream)
    try:
        if status != 200:
            raise Fail(f'{what}: download failed (HTTP {status})')
        digest = hashlib.new(algorithm, with_size.read_bytes()).hexdigest()
        if digest != value:
            raise Fail(f'{what}: checksum verification failed')
        with_size.replace(target)
    finally:
        with_size.unlink(missing_ok=True)
    return target


# --- archive handling ------------------------------------------------------------

def safe_members(archive):
    """Validate every entry before anything is written. Returns [(info, relative path)]."""
    infos = archive.infolist()
    if len(infos) > MAX_ENTRIES:
        raise Fail('The server pack has too many files')
    members, seen, total = [], set(), 0
    for info in infos:
        name = info.filename
        if '\\' in name or '\x00' in name or name.startswith('/') or re.match(r'[A-Za-z]:', name):
            raise Fail('The server pack contains an unsafe path')
        parts = PurePosixPath(name).parts
        if not parts or any(part in ('.', '..') for part in parts):
            raise Fail('The server pack contains an unsafe path')
        mode = info.external_attr >> 16
        if stat.S_IFMT(mode) and not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
            raise Fail('The server pack contains a link or special file')
        if info.flag_bits & 0x1:
            raise Fail('The server pack contains encrypted files')
        if info.is_dir():
            continue
        total += info.file_size
        if total > MAX_UNPACKED or info.file_size > MAX_UNPACKED:
            raise Fail('The unpacked server pack is larger than Squab allows (8 GiB)')
        if info.file_size > 1024**2 and info.file_size > MAX_RATIO * max(info.compress_size, 1):
            raise Fail('The server pack contains a suspicious compression ratio')
        relative = PurePosixPath(*parts)
        if str(relative) in seen:
            raise Fail('The server pack contains duplicate paths')
        seen.add(str(relative))
        members.append((info, relative))
    # Many authors zip a single top-level folder; install its contents at the data root.
    tops = {relative.parts[0] for _, relative in members}
    if len(tops) == 1 and all(len(relative.parts) > 1 for _, relative in members):
        members = [(info, PurePosixPath(*relative.parts[1:])) for info, relative in members]
    members = [(info, relative) for info, relative in members
               if relative.parts[0] != STATE.name and str(relative) != 'eula.txt']
    return members


def extract(archive_path, staging):
    """Extract to staging with streaming size enforcement. Returns {relative: sha1}."""
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True)
    result, written = {}, 0
    try:
        archive = zipfile.ZipFile(archive_path)
    except (zipfile.BadZipFile, OSError):
        raise Fail('The server pack is not a valid zip archive') from None
    with archive:
        for info, relative in safe_members(archive):
            target = staging.joinpath(*relative.parts)
            if not target.resolve().is_relative_to(staging.resolve()):
                raise Fail('The server pack contains an unsafe path')
            target.parent.mkdir(parents=True, exist_ok=True)
            digest, count = hashlib.sha1(), 0
            try:
                with archive.open(info) as source, target.open('xb') as sink:
                    while chunk := source.read(1024 * 1024):
                        count += len(chunk)
                        written += len(chunk)
                        if count > info.file_size or written > MAX_UNPACKED:
                            raise Fail('The server pack expands beyond its declared size')
                        digest.update(chunk)
                        sink.write(chunk)
            except (zipfile.BadZipFile, zlib.error, EOFError, NotImplementedError):
                raise Fail('The server pack archive is corrupt') from None
            except OSError:
                raise Fail('The server pack could not be unpacked (conflicting paths or no disk space)') from None
            result[str(relative)] = digest.hexdigest()
    return result


def sha1_of(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha1').hexdigest()


def level_name(data):
    path = data / 'server.properties'
    if path.is_file() and not path.is_symlink():
        for line in path.read_text(encoding='latin-1').splitlines():
            match = re.match(r'\s*level-name\s*[=:]\s*(.*)$', line)
            if match and match.group(1).strip():
                return match.group(1).strip()
    return 'world'


def apply_pack(data, staging, new_files, old_files, backup):
    """Install pack files over /data, keeping worlds, player lists and user files.

    Files the previous pack installed and the new one dropped are removed when
    unmodified; anything modified that is replaced or removed is moved to backup.
    """
    world = level_name(data)
    protected = {world, f'{world}_nether', f'{world}_the_end'}
    # A world shipped by the pack is installed only when no world exists yet.
    existing_worlds = {name for name in protected if (data / name).exists() or (data / name).is_symlink()}

    def keep_existing(relative):
        return relative in PRESERVED or PurePosixPath(relative).parts[0] in protected

    def move_to_backup(path, relative):
        destination = backup.joinpath(*PurePosixPath(relative).parts)
        destination.parent.mkdir(parents=True, exist_ok=True)
        os.replace(path, destination)

    def unsafe_parent(path):
        current = data
        for part in path.relative_to(data).parts[:-1]:
            current = current / part
            if current.is_symlink() or (current.exists() and not current.is_dir()):
                return True
        return False

    for relative, digest in old_files.items():
        if relative in new_files or keep_existing(relative):
            continue
        path = data.joinpath(*PurePosixPath(relative).parts)
        if unsafe_parent(path) or not (path.is_file() or path.is_symlink()):
            continue
        if path.is_symlink() or sha1_of(path) != digest:
            move_to_backup(path, relative)
        else:
            path.unlink()
    for relative in sorted(new_files):
        source = staging.joinpath(*PurePosixPath(relative).parts)
        target = data.joinpath(*PurePosixPath(relative).parts)
        if PurePosixPath(relative).parts[0] in existing_worlds:
            continue
        if unsafe_parent(target):
            raise Fail(f'Cannot install {relative}: a parent path in /data is a link or a file')
        if target.exists() or target.is_symlink():
            if keep_existing(relative):
                continue
            if target.is_dir() and not target.is_symlink():
                raise Fail(f'Cannot install {relative}: a directory is in the way')
            if target.is_symlink() or (sha1_of(target) != new_files[relative]
                                       and sha1_of(target) != old_files.get(relative)):
                move_to_backup(target, relative)
        target.parent.mkdir(parents=True, exist_ok=True)
        os.replace(source, target)


# --- loader detection and installation --------------------------------------------

LOADERS = ('forge', 'neoforge', 'fabric', 'quilt')


def detect_loader(root):
    """Find (minecraft, loader, version) from server pack metadata; None if unknown."""
    manifest = root / 'manifest.json'
    if manifest.is_file() and manifest.stat().st_size < MAX_JSON:
        found = loader_from_manifest(manifest.read_bytes())
        if found:
            return found
    variables = root / 'variables.txt'
    if variables.is_file() and variables.stat().st_size < 1024**2:
        values = dict(re.findall(r'^\s*([A-Z_]+)\s*=\s*"?([^"\r\n]*)"?\s*$',
                                 variables.read_text(encoding='utf-8', errors='replace'), re.MULTILINE))
        loader = values.get('MODLOADER', '').lower()
        if loader in LOADERS and valid_version(values.get('MINECRAFT_VERSION', '')) \
                and valid_version(values.get('MODLOADER_VERSION', '')):
            return values['MINECRAFT_VERSION'], loader, values['MODLOADER_VERSION']
    for path in sorted(root.iterdir()) if root.is_dir() else []:
        match = re.fullmatch(r'forge-(1\.[0-9.]+)-([0-9][0-9.]*)-installer\.jar', path.name)
        if match:
            return match.group(1), 'forge', match.group(2)
        match = re.fullmatch(r'neoforge-([0-9]+\.[0-9]+\.[0-9]+(?:-beta)?)-installer\.jar', path.name)
        if match:
            return neoforge_minecraft(match.group(1)), 'neoforge', match.group(1)
    for loader, base in (('forge', 'net/minecraftforge/forge'), ('neoforge', 'net/neoforged/neoforge')):
        installed = sorted((root / 'libraries' / base).glob('*/unix_args.txt'))
        if len(installed) == 1:
            version = installed[0].parent.name
            if loader == 'forge' and re.fullmatch(r'1\.[0-9.]+-[0-9.]+', version):
                return version.split('-', 1)[0], 'forge', version.split('-', 1)[1]
            if loader == 'neoforge' and valid_version(version):
                return neoforge_minecraft(version), 'neoforge', version
    return None


def valid_version(value):
    return bool(re.fullmatch(r'[0-9][0-9A-Za-z.+_-]{0,63}', value or ''))


def neoforge_minecraft(version):
    """NeoForge 21.1.x targets 1.21.1; 26.1.x.y targets 26.1."""
    parts = version.split('-')[0].split('.')
    if int(parts[0]) >= 26:
        return '.'.join(parts[:2]) if parts[1] != '0' else parts[0]
    return f'1.{parts[0]}' + (f'.{parts[1]}' if parts[1] != '0' else '')


def loader_from_manifest(raw):
    try:
        manifest = json.loads(raw)
        minecraft = manifest['minecraft']
        loaders = [item for item in minecraft.get('modLoaders', []) if isinstance(item, dict)]
        primary = [item for item in loaders if item.get('primary')] or loaders[:1]
        identifier = primary[0]['id']
        version = minecraft['version']
    except (ValueError, KeyError, TypeError, IndexError, AttributeError):
        return None
    if not isinstance(identifier, str) or not valid_version(version):
        return None
    loader, _, loader_version = identifier.partition('-')
    if loader not in LOADERS or not valid_version(loader_version):
        return None
    return version, loader, loader_version


def client_manifest(api, mod_id, pack_file, cache):
    """Read manifest.json from the version's own (client) file to learn its loader."""
    size, hashes = expected_hashes(pack_file)
    target = cache / f'client-{pack_file["id"]}.zip'
    download(api.download_url(mod_id, pack_file), target, size, hashes, 'Modpack manifest')
    try:
        with zipfile.ZipFile(target) as archive:
            info = archive.getinfo('manifest.json')
            if info.file_size > MAX_JSON:
                raise Fail('The modpack manifest is too large')
            return loader_from_manifest(archive.read(info))
    except (KeyError, zipfile.BadZipFile):
        return None
    finally:
        target.unlink(missing_ok=True)


def java_for(minecraft):
    match = re.fullmatch(r'1\.([0-9]+)(?:\.([0-9]+))?', minecraft)
    if match:
        minor, patch = int(match.group(1)), int(match.group(2) or 0)
        if minor <= 16:
            return 8
        if minor < 20 or (minor == 20 and patch <= 4):
            return 17
        return 21
    match = re.fullmatch(r'([0-9]{2})\.[0-9]+(?:\.[0-9]+)?', minecraft)
    if match and int(match.group(1)) >= 26:
        return 25
    raise Fail(f'Unsupported Minecraft version {minecraft!r}; set JAVA_VERSION explicitly', 64)


def launch_target(data, loader, minecraft, version):
    """Return the Java arguments that start an installed loader, or None."""
    if loader in ('forge', 'neoforge'):
        group = 'net/minecraftforge/forge' if loader == 'forge' else 'net/neoforged/neoforge'
        name = f'{minecraft}-{version}' if loader == 'forge' else version
        if loader == 'neoforge' and minecraft == '1.20.1':
            group, name = 'net/neoforged/forge', f'1.20.1-{version}'
        args = data / 'libraries' / group / name / 'unix_args.txt'
        if args.is_file():
            return ['@' + str(args.relative_to(data))]
        prefix = 'forge' if loader == 'forge' or minecraft == '1.20.1' else 'neoforge'
        for candidate in (f'{prefix}-{name}-shim.jar', f'{prefix}-{name}.jar', f'{prefix}-{name}-universal.jar'):
            if (data / candidate).is_file():
                return ['-jar', candidate]
        return None
    jar = 'fabric-server-launch.jar' if loader == 'fabric' else 'quilt-server-launch.jar'
    if (data / jar).is_file() and (data / 'server.jar').is_file():
        return ['-jar', jar]
    return None


def mojang_server(minecraft):
    status, _, body = request(MOJANG_MANIFEST)
    if status != 200:
        raise Fail('Could not read the official Minecraft version list')
    try:
        entry = next(v for v in json.loads(body)['versions'] if v['id'] == minecraft)
        status, _, body = request(entry['url'])
        server = json.loads(body)['downloads']['server']
        size, sha1, url = server['size'], server['sha1'], server['url']
    except (StopIteration, ValueError, KeyError, TypeError):
        raise Fail(f'Minecraft {minecraft} has no official server download') from None
    if status != 200 or type(size) is not int or not re.fullmatch('[0-9a-f]{40}', str(sha1)):
        raise Fail('Invalid official Minecraft server metadata')
    return url, size, sha1


def run_installer(java, arguments, data, what):
    log(f'Installing {what} with the official installer (output in {STATE.name}/installer.log)')
    with (STATE / 'installer.log').open('wb') as output:
        try:
            result = subprocess.run([f'{JAVA[java]}/bin/java', *jvm_common(), *arguments], cwd=data,
                                    stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                    env=child_environment(), timeout=1800)
        except subprocess.TimeoutExpired:
            raise Fail(f'{what} installation timed out') from None
    if result.returncode:
        raise Fail(f'{what} installation failed; see {STATE.name}/installer.log')


def install_loader(data, loader, minecraft, version, java):
    tools = STATE / 'installers'
    tools.mkdir(parents=True, exist_ok=True)
    if not valid_version(version) or not valid_version(minecraft):
        raise Fail('Invalid loader version')
    try:
        if loader == 'forge':
            name = f'{minecraft}-{version}'
            url = f'https://maven.minecraftforge.net/net/minecraftforge/forge/{name}/forge-{name}-installer.jar'
            jar = sidecar_download(url, tools / f'forge-{name}-installer.jar', f'Forge {version} installer')
            run_installer(java, ['-jar', str(jar), '--installServer'], data, f'Forge {version}')
        elif loader == 'neoforge':
            if minecraft == '1.20.1':
                name = f'1.20.1-{version}'
                url = f'https://maven.neoforged.net/releases/net/neoforged/forge/{name}/forge-{name}-installer.jar'
            else:
                url = (f'https://maven.neoforged.net/releases/net/neoforged/neoforge/{version}/'
                       f'neoforge-{version}-installer.jar')
            jar = sidecar_download(url, tools / f'neoforge-{version}-installer.jar', f'NeoForge {version} installer')
            run_installer(java, ['-jar', str(jar), '--installServer'], data, f'NeoForge {version}')
        else:
            url, size, sha256 = FABRIC_INSTALLER if loader == 'fabric' else QUILT_INSTALLER
            jar = tools / url.rsplit('/', 1)[1]
            with_hash(url, jar, size, sha256, f'{loader.title()} installer')
            if loader == 'fabric':
                arguments = ['-jar', str(jar), 'server', '-mcversion', minecraft, '-loader', version,
                             '-dir', str(data)]
            else:
                arguments = ['-jar', str(jar), 'install', 'server', minecraft, version,
                             f'--install-dir={data}']
            run_installer(java, arguments, data, f'{loader.title()} {version}')
            server_url, server_size, server_sha1 = mojang_server(minecraft)
            download(server_url, data / 'server.jar', server_size, {'sha1': server_sha1},
                     f'Minecraft {minecraft} server')
    finally:
        shutil.rmtree(tools, ignore_errors=True)
    target = launch_target(data, loader, minecraft, version)
    if target is None:
        raise Fail(f'{loader} {version} installed no recognised server launcher')
    return target


def with_hash(url, target, size, sha256, what):
    target.unlink(missing_ok=True)
    with target.open('xb') as stream:
        status, _, _ = request(url, limit=size, sink=stream)
    if status != 200 or target.stat().st_size != size or \
            hashlib.sha256(target.read_bytes()).hexdigest() != sha256:
        target.unlink(missing_ok=True)
        raise Fail(f'{what}: download or checksum verification failed')


# --- server.properties -------------------------------------------------------------

def escape_property(value):
    out = []
    for char in str(value):
        if char in '\\:=#!':
            out.append('\\' + char)
        elif ord(char) > 126 or ord(char) < 32:
            out.append(''.join(f'\\u{unit:04x}' for unit in
                               [int.from_bytes(char.encode('utf-16-be')[i:i + 2], 'big')
                                for i in range(0, len(char.encode('utf-16-be')), 2)]))
        else:
            out.append(char)
    return ''.join(out)


def write_properties(data, managed):
    path = data / 'server.properties'
    lines = []
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise Fail('server.properties is not a regular file', 64)
    if path.exists():
        if path.stat().st_size > 1024**2:
            raise Fail('server.properties is too large', 64)
        lines = path.read_text(encoding='latin-1').splitlines()
    values = {**managed, 'online-mode': 'true', 'server-port': '25565', 'server-ip': ''}
    result = []
    for line in lines:
        match = re.match(r'\s*([^#!\s=:][^\s=:]*)\s*[=:]', line)
        if match and match.group(1) in values:
            continue
        result.append(line)
    result.extend(f'{key}={escape_property(value)}' for key, value in values.items())
    temporary = path.with_name('.server.properties.squab')
    temporary.write_text('\n'.join(result) + '\n', encoding='latin-1')
    temporary.replace(path)


# --- state and process ---------------------------------------------------------

def load_state():
    path = STATE / 'state.json'
    if not path.is_file() or path.is_symlink():
        return {}
    try:
        value = json.loads(path.read_text())
    except ValueError:
        raise Fail('Squab CurseForge state is corrupt; restore a backup or reinstall', 64) from None
    return value if isinstance(value, dict) else {}


def save_state(value):
    path = STATE / 'state.json'
    temporary = path.with_name('.state.json.tmp')
    with temporary.open('w') as stream:
        json.dump(value, stream, indent=1, sort_keys=True)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def child_environment():
    home = STATE / 'home'
    home.mkdir(parents=True, exist_ok=True)
    return {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': str(home), 'LANG': 'C.UTF-8',
            'TMPDIR': str(STATE / 'tmp')}


def jvm_common():
    temporary = STATE / 'tmp'
    temporary.mkdir(parents=True, exist_ok=True)
    return [f'-Djava.io.tmpdir={temporary}', f'-Duser.home={STATE / "home"}']


def java_command(java, target):
    return [f'{JAVA[java]}/bin/java', '-XX:MaxRAMPercentage=75.0', '-XX:+UseG1GC',
            '-Dlog4j2.formatMsgNoLookups=true', *jvm_common(), *target, 'nogui']


def prune(directory, keep, count):
    if not directory.is_dir():
        return
    entries = sorted((p for p in directory.iterdir() if p.name not in keep), key=lambda p: p.stat().st_mtime)
    for old in entries[:max(len(entries) - count, 0)]:
        shutil.rmtree(old) if old.is_dir() and not old.is_symlink() else old.unlink()


def install(api, config, state):
    """Bring /data to the requested pack version. Returns the updated state."""
    kind, value = config['modpack']
    mod = api.project(kind, value)
    if state.get('project_id') not in (None, mod['id']):
        raise Fail('CF_MODPACK names a different modpack than the one installed in /data. '
                   'Changing the modpack would destroy this world; create a new server instead.', 64)
    pack, server = select_files(api, mod, config['file_id'])
    log(f'Modpack "{mod.get("name", mod["id"])}" version "{pack.get("displayName", pack["id"])}" '
        f'(file {pack["id"]}, server pack {server["id"]})')
    installed = state.get('installed') or {}
    if installed.get('server_pack_file_id') == server['id'] and state.get('pending') is None:
        return dict(state, project_id=mod['id'])
    size, hashes = expected_hashes(server)
    cache = STATE / 'cache'
    archive = download(api.download_url(mod['id'], server), cache / f'server-{server["id"]}.zip',
                       size, hashes, 'Server pack')
    staging = STATE / 'staging'
    new_files = extract(archive, staging)
    detected = detect_loader(staging)
    if not detected and pack is not server:
        log('The server pack does not name its loader; reading the modpack manifest')
        detected = client_manifest(api, mod['id'], pack, cache)
    if not detected:
        raise Fail('Could not determine the mod loader and Minecraft version of this server pack')
    minecraft, loader, version = detected
    state = dict(state, project_id=mod['id'],
                 pending={'pack_file_id': pack['id'], 'server_pack_file_id': server['id']})
    save_state(state)
    backup = STATE / 'replaced' / time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
    apply_pack(DATA, staging, new_files, installed.get('files', {}), backup)
    shutil.rmtree(staging, ignore_errors=True)
    if backup.exists():
        log(f'Modified files replaced by the pack were kept in {backup.relative_to(DATA)}')
    prune(STATE / 'replaced', set(), 3)
    prune(cache, {archive.name}, 0)
    state = {'project_id': mod['id'], 'pending': None, 'installed': {
        'pack_file_id': pack['id'], 'server_pack_file_id': server['id'],
        'display_name': str(pack.get('displayName', ''))[:200], 'files': new_files,
        'minecraft': minecraft, 'loader': loader, 'loader_version': version}}
    save_state(state)
    return state


def prepare(environ):
    validate_environment(environ)
    config = settings(environ)
    key = read_api_key(environ)
    if DATA.is_symlink() or not DATA.is_dir():
        raise Fail('/data is not a directory', 66)
    if STATE.is_symlink() or (STATE.exists() and not STATE.is_dir()):
        raise Fail(f'/data/{STATE.name} must be a directory', 66)
    for directory in (STATE, STATE / 'tmp', STATE / 'home'):
        directory.mkdir(mode=0o700, exist_ok=True)
    lock = (STATE / 'lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        raise Fail('Another launcher is already using /data', 66) from None
    try:
        return launch(config, CurseForge(key)), lock
    except BaseException:
        lock.close()
        raise


def launch(config, api):
    """Install or update as needed and return the Java command line."""
    state = load_state()
    installed = state.get('installed') or {}
    pinned = config['file_id'] is not None and config['file_id'] in (
        installed.get('pack_file_id'), installed.get('server_pack_file_id'))
    if pinned and state.get('pending') is None:
        log(f'Modpack version {installed.get("display_name") or config["file_id"]} is installed')
    else:
        try:
            state = install(api, config, state)
        except Transient as error:
            if not installed or config['file_id'] is not None or state.get('pending') is not None:
                raise
            log(str(error))
            log('Could not check for a newer modpack version; starting the installed version')
        installed = state['installed']
    minecraft, loader, version = installed['minecraft'], installed['loader'], installed['loader_version']
    java = java_for(minecraft) if config['java'] == 'auto' else int(config['java'])
    if config['java'] != 'auto' and java != java_for(minecraft):
        log(f'JAVA_VERSION={java} overrides the automatic choice (Java {java_for(minecraft)}) for Minecraft {minecraft}')
    target = launch_target(DATA, loader, minecraft, version)
    if target is None:
        target = install_loader(DATA, loader, minecraft, version, java)
    write_properties(DATA, config['properties'])
    (DATA / 'eula.txt').write_text('eula=true\n')
    log(f'Starting Minecraft {minecraft} with {loader} {version} on Java {java}')
    return java_command(java, target)


def main():
    os.umask(0o077)
    if sys.argv[1:]:
        raise Fail('Extra arguments are not supported', 64)
    command, lock = prepare(dict(os.environ))
    os.chdir(DATA)
    # The lock descriptor stays open across exec, so only one server uses /data.
    os.set_inheritable(lock.fileno(), True)
    os.execve(command[0], command, child_environment())


if __name__ == '__main__':
    try:
        main()
    except Fail as failure:
        log('CurseForge: ' + str(failure))
        sys.exit(failure.code)
    except Exception as error:  # noqa: BLE001 - never print tracebacks that could include request data
        log(f'CurseForge launcher failed unexpectedly ({type(error).__name__}). Installed files are preserved.')
        sys.exit(70)
